DATABASE_URL=sqlite:////var/data/aegistrace.db
GROQ_API_KEY=your_groq_key_here
VIRUSTOTAL_API_KEY=your_vt_key_here
ADMIN_PIN=your_secure_pin_here
PUBLIC_URL=https://your-domain.onrender.com

# MaxMind GeoLite2 — offline IP→country for ITDR impossible-travel detection.
# Free account + license key: https://www.maxmind.com/en/geolite2/signup
# Optional — without it, lookup_country() is a no-op (no breakage).
MAXMIND_LICENSE_KEY=

# ── EDR Integrations (add whichever you have) ─────────────────────────────────
# CrowdStrike Falcon  (API Client — Falcon Console → API Clients & Keys)
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com   # US-1 default; change for EU/GovCloud

# SentinelOne  (My User → API Token in SentinelOne console)
SENTINELONE_BASE_URL=https://your-tenant.sentinelone.net
SENTINELONE_API_TOKEN=

# Carbon Black Cloud  (Settings → API Access → API Keys)
CARBONBLACK_ORG_KEY=
CARBONBLACK_API_ID=
CARBONBLACK_API_SECRET=
CARBONBLACK_BASE_URL=https://defense.conferdeploy.net  # change per region

# Optional: GreyNoise community key (improves rate limits for enrichment)
GREYNOISE_API_KEY=

# ── Email / Report Scheduling ─────────────────────────────────────────────────
# Option A: SendGrid (recommended for production)
SENDGRID_API_KEY=

# Option B: SMTP (Gmail, Outlook, self-hosted, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password       # Gmail: use App Password, not your login password
SMTP_FROM=AegisTrace SOC <your-email@gmail.com>
